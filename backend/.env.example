# VaultForge Backend — Environment Variables
# Copy to .env and fill in secrets. NEVER commit .env

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=                      # Get from supabase.com → Settings → API
SUPABASE_ANON_KEY=                 # Anon/public key (used for client-side, read-only)
SUPABASE_SERVICE_ROLE_KEY=         # Service role key (NOT anon key) — bypasses RLS
SUPABASE_DB_URL=                   # Direct Postgres URL (optional, for migrations)

# ── Blockchain (opBNB Testnet — chain 5611) ──────────────────────────
OPBNB_TESTNET_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
DEPLOYER_PRIVATE_KEY=              # Deployer wallet: cast wallet new

# ── Contract Addresses (opBNB Testnet) ───────────────────────────────
VAULT_FACTORY_ADDRESS=0xD26ae761DEBE79Ca423A370C0085D75b26Ecaf28
VAULT_IMPLEMENTATION_ADDRESS=0x1777f993b35fe74EcA9178DA576a71aaf9F06f8A
ZK_VERIFIER_ADDRESS=0x528eeF03cE66493FAC386Bd7DAC6E4a89C4786f8
AGENT_REGISTRY_ADDRESS=0xD5932aF5c315C0A1fD9D486E0f58b7C210866ADF
RELAYER_ADDRESS=                   # Optional: meta-tx relayer

# ── Auth (Privy) ─────────────────────────────────────────────────────
PRIVY_APP_ID=                      # Get from dashboard.privy.io
PRIVY_APP_SECRET=                  # Get from dashboard.privy.io

# ── Backend API ──────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
API_KEY=                           # Internal agent API key: openssl rand -hex 32

# ── ZK ───────────────────────────────────────────────────────────────
SNARKJS_PATH=./zk-circuits/node_modules/.bin/snarkjs

# ── Oracles ──────────────────────────────────────────────────────────
CHAINLINK_BNB_USD_FEED=            # Chainlink price feed address (optional)

# ── External APIs ────────────────────────────────────────────────────
ZERION_API_KEY=                    # Get from developers.zerion.io

# ── CORS & Environment ──────────────────────────────────────────────
CORS_ORIGINS=https://vaultforge-nu.vercel.app,http://localhost:3000
ENVIRONMENT=development
