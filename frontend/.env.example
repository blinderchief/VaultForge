# VaultForge Frontend — Environment Variables
# Copy to .env.local and fill in secrets. NEVER commit .env.local

# ── Auth (Privy) ─────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=          # Get from dashboard.privy.io

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=          # Get from supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Get from supabase.com → Settings → API

# ── Blockchain (opBNB Testnet — chain 5611) ──────────────────────────
NEXT_PUBLIC_OPBNB_RPC=https://opbnb-testnet-rpc.bnbchain.org
NEXT_PUBLIC_CHAIN_ID=5611

# ── Contract Addresses (opBNB Testnet) ───────────────────────────────
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=0xEd871ed2D9281B175B42597b50748B9Ee8e951F7
NEXT_PUBLIC_VAULT_IMPL_ADDRESS=0x671419bb5a8CeF7547f661212030F998B7992ACE
NEXT_PUBLIC_ZK_VERIFIER_ADDRESS=0x05bcAB91C51104853f796F5D7bd57EF8077E904D
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=0xD233dEbF4C760f93AA61C6fA7f668c19CA93aaC0
NEXT_PUBLIC_LTV_ORACLE_ADDRESS=0x16165ad7A069Ada84F97a6311c9A62c700AC43d8

# ── Backend API ──────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
