# ╔══════════════════════════════════════════════════════════════════════╗
# ║  VaultForge — Environment Variables                                ║
# ║  Copy to .env and fill in all values. NEVER commit .env            ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Blockchain ───────────────────────────────────────────────────────
# opBNB Testnet RPC endpoint
OPBNB_TESTNET_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org

# BSC Testnet RPC (for bridging / cross-chain reads)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Deployer wallet private key — used by Foundry scripts. NEVER COMMIT.
DEPLOYER_PRIVATE_KEY=

# API key for contract verification on opBNBScan / BSCScan
ETHERSCAN_API_KEY=

# ── Contract Addresses (populated after Phase 7 deploy) ─────────────
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=0xD26ae761DEBE79Ca423A370C0085D75b26Ecaf28
NEXT_PUBLIC_VAULT_IMPLEMENTATION_ADDRESS=0x1777f993b35fe74EcA9178DA576a71aaf9F06f8A
NEXT_PUBLIC_ZK_VERIFIER_ADDRESS=0x528eeF03cE66493FAC386Bd7DAC6E4a89C4786f8
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=0xD5932aF5c315C0A1fD9D486E0f58b7C210866ADF
NEXT_PUBLIC_LTV_ORACLE_ADDRESS=0x4B6171fA771fdA1F86445a5C06b0d5dA11875BC4

# ── Privy (Auth) ────────────────────────────────────────────────────
# App ID from Privy dashboard (exposed to browser)
NEXT_PUBLIC_PRIVY_APP_ID=

# App secret for backend JWT verification — NEVER expose to frontend
PRIVY_APP_SECRET=

# ── Supabase ────────────────────────────────────────────────────────
# Public project URL (exposed to browser, RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (exposed to browser, RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — backend only, bypasses RLS. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (backend migrations / direct queries)
SUPABASE_DB_URL=

# ── Backend API ─────────────────────────────────────────────────────
# Base URL for the FastAPI backend
BACKEND_URL=http://localhost:8000

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Path to snarkjs CLI or node_modules/.bin/snarkjs
SNARKJS_PATH=./zk-circuits/node_modules/.bin/snarkjs

# ── Oracles ─────────────────────────────────────────────────────────
# Chainlink BNB/USD price feed contract address on opBNB/BSC testnet
CHAINLINK_BNB_USD_FEED=

# ── External APIs ───────────────────────────────────────────────────
# Zerion API key for portfolio positions proxy
ZERION_API_KEY=

# ── Frontend (Next.js) ──────────────────────────────────────────────
# Backend API URL (exposed to browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# opBNB chain ID (exposed to browser)
NEXT_PUBLIC_CHAIN_ID=5611
